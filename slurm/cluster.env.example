# Copy to slurm/cluster.env (gitignored) and adapt to your cluster.
# Sourced by slurm/submit.sh and by every job. Check your cluster with:
#   sinfo -o "%P %l %G"      (partitions, time limits, GPU types)
#   sacctmgr show assoc user=$USER format=account,partition
# See docs/cluster-runbook.md for the complete workflow.

# ---- Paths (all large files live on scratch) --------------------------------
# HANDOFF_SCRATCH must be visible from every compute node (the simulator job
# publishes its endpoint there for the evaluation and training jobs); the setup
# job refuses a node-local filesystem. Check a candidate with `df -T <path>` on
# two nodes. Space: environment ~15 GB, models ~70 GB, each RL run ~100 GB
# (its latest resumable checkpoint ~50 GB plus an 8 GB bf16 export per saved
# step), evaluation runs well under 1 GB each.
# A directory in your home works if the quota allows; a node-local /tmp does not.
# NUS SoC cluster (DocHub, Oct 2026): the cluster home is shared all-flash NFS
# (500 GB quota) and /mnt/scratch is shared HDD NFS (500 GB); /tmp is node-local.
export HANDOFF_SCRATCH="${HOME}/handoff"
# Slurm job logs; the default (logs/ in this checkout) is on the shared home.
# export HANDOFF_LOGS="${HOME}/handoff-logs"
export HANDOFF_VENV="${HANDOFF_SCRATCH}/venv"    # created by: submit.sh setup
export HF_HOME="${HANDOFF_SCRATCH}/hf_cache"     # model snapshots
export UV_CACHE_DIR="${HANDOFF_SCRATCH}/uv_cache"
export XDG_CACHE_HOME="${HANDOFF_SCRATCH}/cache"   # vLLM/Triton caches
export TAU2_REPO_DIR="${HANDOFF_SCRATCH}/third_party/tau2-bench"
export TAU2_DATA_DIR="${TAU2_REPO_DIR}/data"
export TAU2_COMMIT="fc0055dc4e0a316c3f83133267fbd6faaa770992"  # tau2 v1.0.1 (ADR-005)
export HANDOFF_PYTHON="3.12"

# ---- Slurm -----------------------------------------------------------------
SLURM_ACCOUNT=""            # empty: default account
PARTITION_GPU="gpu-long"    # GPU partition that allows the TIME_* limits below
PARTITION_CPU="long"        # CPU partition (task sets, SFT data, reports)
GPU_TYPE_ANY=""             # setup job; empty = any GPU
# NUS SoC (sinfo, 3 Oct 2026): gpu-long has 2 nodes with a100-80 and 5 nodes
# with 2 x h100-96; the only H200 node is in the 3-hour `gpu` partition.
GPU_TYPE_SIM="a100-80"      # user-simulator server (Qwen3-30B-A3B bf16 needs ~70 GB); h100-96 also fits
GPU_TYPE_BIG="h100-96"      # policy evaluation, SFT and RL (h200-141 only with PARTITION_GPU=gpu, 3 h)
TIME_SETUP="04:00:00"
TIME_CPU="08:00:00"
TIME_SERVE="3-00:00:00"     # the simulator stays up for a whole campaign
TIME_EVAL="1-00:00:00"
TIME_SFT="1-00:00:00"
TIME_RL="3-00:00:00"        # longer runs resume with: submit.sh rl RESUME=<run_id>
CPUS_GPU_JOB=16
MEM_GPU_JOB="200G"

# ---- Optional secrets (never commit them) -----------------------------------
# export HF_TOKEN=...        # only for gated models
# export WANDB_API_KEY=...   # then add EXTRA='rl.verl.trainer.logger=[console,wandb]'
